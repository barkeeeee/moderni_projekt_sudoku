class SudokuBoard {
    field Array board, fixed, solution;

    constructor SudokuBoard new(int seed) {
        var int i, pick;
        let board = Array.new(81);
        let fixed = Array.new(81);
        let solution = Array.new(81);
        let i = 0;
        while (i < 81) { let board[i]=0; let fixed[i]=0; let solution[i]=0; let i=i+1; }

        let pick = seed - ((seed / 3) * 3);
        if (pick = 0) { do load0(); }
        if (pick = 1) { do load1(); }
        if (pick = 2) { do load2(); }
        return this;
    }

    method void setC(int r, int c, int v) {
        let board[(r*9)+c]=v; let fixed[(r*9)+c]=1; let solution[(r*9)+c]=v; return;
    }
    method void setS(int r, int c, int v) {
        let solution[(r*9)+c]=v; return;
    }

    method void load0() {
        do setC(0,0,5); do setC(0,1,3); do setC(0,4,7); do setC(1,0,6); do setC(1,3,1); do setC(1,4,9); do setC(1,5,5); do setC(2,1,9); do setC(2,2,8); do setC(2,7,6);
        do setC(3,0,8); do setC(3,4,6); do setC(3,8,3); do setC(4,0,4); do setC(4,3,8); do setC(4,5,3); do setC(4,8,1); do setC(5,0,7); do setC(5,4,2); do setC(5,8,6);
        do setC(6,1,6); do setC(6,6,2); do setC(6,7,8); do setC(7,3,4); do setC(7,4,1); do setC(7,5,9); do setC(7,8,5); do setC(8,4,8); do setC(8,7,7); do setC(8,8,9);
        do setS(0,2,4); do setS(0,3,6); do setS(0,5,8); do setS(0,6,9); do setS(0,7,1); do setS(0,8,2); do setS(1,1,7); do setS(1,2,2); do setS(1,6,3); do setS(1,7,4);
        do setS(1,8,8); do setS(2,0,1); do setS(2,3,3); do setS(2,4,4); do setS(2,5,2); do setS(2,6,5); do setS(2,8,7); do setS(3,1,5); do setS(3,2,9); do setS(3,3,7);
        do setS(3,5,1); do setS(3,6,4); do setS(3,7,2); do setS(4,1,2); do setS(4,2,6); do setS(4,4,5); do setS(4,6,7); do setS(4,7,9); do setS(5,1,1); do setS(5,2,3);
        do setS(5,3,9); do setS(5,5,4); do setS(5,6,8); do setS(5,7,5); do setS(6,0,9); do setS(6,2,1); do setS(6,3,5); do setS(6,4,3); do setS(6,5,7); do setS(6,8,4);
        do setS(7,0,2); do setS(7,1,8); do setS(7,2,7); do setS(7,6,6); do setS(7,7,3); do setS(8,0,3); do setS(8,1,4); do setS(8,2,5); do setS(8,3,2); do setS(8,5,6); do setS(8,6,1);
        return;
    }

    method void load1() {
        do setC(0,1,2); do setC(0,3,6); do setC(0,5,8); do setC(1,0,5); do setC(1,1,8); do setC(1,5,9); do setC(1,6,7); do setC(3,0,3); do setC(3,1,7); do setC(3,6,5);
        do setC(4,0,6); do setC(4,8,4); do setC(5,2,8); do setC(5,7,1); do setC(5,8,3); do setC(7,2,9); do setC(7,3,8); do setC(7,7,3); do setC(7,8,6); do setC(8,3,3);
        do setC(8,5,6); do setC(8,7,9); do setS(0,0,1); do setS(0,2,3); do setS(0,4,7); do setS(0,6,9); do setS(0,7,4); do setS(0,8,5); do setS(1,2,4); do setS(1,3,2);
        do setS(1,4,3); do setS(1,7,6); do setS(1,8,1); do setS(2,0,9); do setS(2,1,6); do setS(2,2,7); do setS(2,3,1); do setS(2,4,4); do setS(2,5,5); do setS(2,6,3);
        do setS(2,7,2); do setS(2,8,8); do setS(3,2,2); do setS(3,3,4); do setS(3,4,6); do setS(3,5,1); do setS(3,7,8); do setS(3,8,9); do setS(4,1,9); do setS(4,2,1);
        do setS(4,3,5); do setS(4,4,8); do setS(4,5,3); do setS(4,6,2); do setS(4,7,7); do setS(5,0,4); do setS(5,1,5); do setS(5,3,7); do setS(5,4,9); do setS(5,5,2);
        do setS(5,6,6); do setS(6,0,8); do setS(6,1,3); do setS(6,2,6); do setS(6,3,9); do setS(6,4,2); do setS(6,5,4); do setS(6,6,1); do setS(6,7,5); do setS(6,8,7);
        do setS(7,0,2); do setS(7,1,1); do setS(7,4,5); do setS(7,5,7); do setS(7,6,4); do setS(8,0,7); do setS(8,1,4); do setS(8,2,5); do setS(8,4,1); do setS(8,6,8); do setS(8,8,2);
        return;
    }

    method void load2() {
        do setC(0,0,1); do setC(0,5,7); do setC(0,7,9); do setC(1,1,3); do setC(1,4,2); do setC(1,8,8); do setC(2,2,9); do setC(2,3,6); do setC(2,6,5); do setC(3,2,5);
        do setC(3,3,3); do setC(3,6,9); do setC(4,1,1); do setC(4,4,8); do setC(4,8,2); do setC(5,0,6); do setC(5,5,4); do setC(6,0,3); do setC(6,7,1); do setC(7,1,4);
        do setC(7,8,7); do setC(8,2,7); do setC(8,6,3); do setS(0,1,6); do setS(0,2,2); do setS(0,3,8); do setS(0,4,5); do setS(0,6,4); do setS(0,8,3); do setS(1,0,5);
        do setS(1,2,4); do setS(1,3,1); do setS(1,5,9); do setS(1,6,6); do setS(1,7,7); do setS(2,0,7); do setS(2,1,8); do setS(2,4,4); do setS(2,5,3); do setS(2,7,2);
        do setS(2,8,1); do setS(3,0,4); do setS(3,1,7); do setS(3,4,1); do setS(3,5,2); do setS(3,7,8); do setS(3,8,6); do setS(4,0,9); do setS(4,2,3); do setS(4,3,5);
        do setS(4,5,6); do setS(4,6,7); do setS(4,7,4); do setS(5,1,2); do setS(5,2,8); do setS(5,3,7); do setS(5,4,9); do setS(5,6,1); do setS(5,7,3); do setS(5,8,5);
        do setS(6,1,5); do setS(6,2,6); do setS(6,3,4); do setS(6,4,7); do setS(6,5,8); do setS(6,6,2); do setS(6,8,9); do setS(7,0,2); do setS(7,2,1); do setS(7,3,9);
        do setS(7,4,3); do setS(7,5,5); do setS(7,6,8); do setS(7,7,6); do setS(8,0,8); do setS(8,1,9); do setS(8,3,2); do setS(8,4,6); do setS(8,5,1); do setS(8,7,5); do setS(8,8,4);
        return;
    }

    method int get(int r, int c) { return board[(r*9)+c]; }
    method boolean isFixed(int r, int c) { return fixed[(r*9)+c] = 1; }
    method void set(int r, int c, int v) { if (~isFixed(r,c)) { let board[(r*9)+c]=v; } return; }

    /** True if placing v at (r,c) would duplicate v in that row, column or 3x3 box
        Targeted cell is skipped - overwriting your own entry is ok */
    method boolean conflicts(int r, int c, int v) {
        var int i, j, br, bc;
        if (v = 0) { return false; }
        let i = 0;
        while (i < 9) {
            if (~(i = c)) { if (board[(r*9)+i] = v) { return true; } }
            if (~(i = r)) { if (board[(i*9)+c] = v) { return true; } }
            let i = i + 1;
        }
        let br = (r / 3) * 3;
        let bc = (c / 3) * 3;
        let i = br;
        while (i < (br + 3)) {
            let j = bc;
            while (j < (bc + 3)) {
                if (~((i = r) & (j = c))) {
                    if (board[(i*9)+j] = v) { return true; }
                }
                let j = j + 1;
            }
            let i = i + 1;
        }
        return false;
    }

    method boolean isFull() {
        var int i; let i = 0;
        while (i < 81) { if (board[i] = 0) { return false; } let i = i + 1; }
        return true;
    }

    method boolean isSolved() {
        var int i; let i = 0;
        while (i < 81) { if (~(board[i] = solution[i])) { return false; } let i = i + 1; }
        return true;
    }
    method void dispose() { do board.dispose(); do fixed.dispose(); do solution.dispose(); do Memory.deAlloc(this); return; }
}
