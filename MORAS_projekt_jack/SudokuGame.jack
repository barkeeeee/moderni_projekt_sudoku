class SudokuGame {
    field SudokuBoard board;
    field int curR, curC, oldR, oldC, mistakes;

    constructor SudokuGame new(int seed) {
        let board = SudokuBoard.new(seed);
        let curR = 0; let curC = 0; let oldR = 0; let oldC = 0;
        let mistakes = 0;
        do Draw.clearScreen();
        do drawGrid();
        do drawAll();
        do drawStatus();
        do drawHelp();
        return this;
    }

    method void drawGrid() {
        var int i, p; let i = 0;
        while (i < 10) {
            let p = 100 + (i * 22);
            do Draw.drawVLine(p, 20, 218, true);
            do Draw.drawHLine(100, 298, 20 + (i * 22), true);
            if (((i / 3) * 3) = i) {
                do Draw.drawVLine(p + 1, 20, 218, true);
                do Draw.drawHLine(100, 298, 21 + (i * 22), true);
            }
            let i = i + 1;
        }
        return;
    }

    method void drawCell(int r, int c) {
        var int v, px, py;
        let v = board.get(r, c);
        let px = 108 + (c * 22); let py = 27 + (r * 22);
        // erase to +21 so the cursor underline at py+14 sits inside the cleared box
        do Draw.fillRect(100+(c*22)+2, 20+(r*22)+2, 100+(c*22)+20, 20+(r*22)+21, false);
        if (v > 0) {
            do Draw.drawDigit(v, px, py, true);
            if (board.isFixed(r, c)) {
                do Draw.drawPixel(px-4, py-4, true); do Draw.drawPixel(px-3, py-4, true);
                do Draw.drawPixel(px-4, py-3, true); do Draw.drawPixel(px-3, py-3, true);
            }
        }
        if ((r = curR) & (c = curC)) { do Draw.drawHLine(px-2, px+6, py+14, true); }
        return;
    }

    method void drawAll() {
        var int r, c; let r = 0;
        while (r < 9) { let c = 0; while (c < 9) { do drawCell(r, c); let c = c + 1; } let r = r + 1; }
        return;
    }

    method void drawStatus() {
        do Output.moveCursor(20, 4);
        do Output.printString("MISTAKES ");
        do Output.printInt(mistakes);
        do Output.printString(" / 3");
        return;
    }

    method void drawHelp() {
        do Output.moveCursor(22, 2);
        do Output.printString("arrows move   1-9 place   space clear   esc quit");
        return;
    }

    method void clearMsg() {
        do Draw.fillRect(230, 220, 470, 232, false);
        return;
    }

    method void showMsg(String s) {
        do clearMsg();
        do Output.moveCursor(20, 30);
        do Output.printString(s);
        return;
    }

    /** Handles digit keypress - returns true if the game should end */
    method boolean place(int d) {
        if (board.isFixed(curR, curC)) { return false; }
        if (board.conflicts(curR, curC, d)) {
            let mistakes = mistakes + 1;
            do drawStatus();
            if (mistakes > 2) {
                do showMsg("GAME OVER");
                do Sys.wait(3000);
                return true;
            }
            do showMsg("ALREADY USED");
            do Sys.wait(900);
            do clearMsg();
            return false;
        }
        do board.set(curR, curC, d);
        do drawCell(curR, curC);
        do clearMsg();
        if (board.isFull()) {
            if (board.isSolved()) {
                do showMsg("SOLVED!");
                do Sys.wait(3000);
                return true;
            }
        }
        return false;
    }

    method void run() {
        var char key; var boolean exit; let exit = false;
        while (~exit) {
            while (key = 0) { let key = Keyboard.keyPressed(); }
            let oldR = curR; let oldC = curC;
            if (key = 131) { if (curR > 0) { let curR = curR - 1; } }
            if (key = 133) { if (curR < 8) { let curR = curR + 1; } }
            if (key = 130) { if (curC > 0) { let curC = curC - 1; } }
            if (key = 132) { if (curC < 8) { let curC = curC + 1; } }
            if (~(oldR = curR) | ~(oldC = curC)) { do drawCell(oldR, oldC); do drawCell(curR, curC); }
            if ((key > 48) & (key < 58)) { let exit = place(key - 48); }
            if ((key = 32) | (key = 129)) { do board.set(curR, curC, 0); do drawCell(curR, curC); }
            if (key = 140) { let exit = true; }
            if (key = 128) {
                if (board.isSolved()) {
                    do showMsg("SOLVED!");
                    do Sys.wait(3000);
                    let exit = true;
                } else {
                    do showMsg("NOT DONE YET");
                    do Sys.wait(900);
                    do clearMsg();
                }
            }
            while (~(key = 0)) { let key = Keyboard.keyPressed(); }
        }
        return;
    }

    method void dispose() { do board.dispose(); do Memory.deAlloc(this); return; }
}
